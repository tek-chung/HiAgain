# Copy to .env.local and fill in. Never commit real values.

# Public base URL used inside QR codes and OAuth redirects.
# Local: http://localhost:3000   Phone testing needs a stable HTTPS URL (e.g. a Vercel preview).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings -> API). The anon key is designed to be public; RLS protects data.
# Leave both blank to run in development-fixture mode (fictional profiles, no sign-in).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT add the Supabase service-role key. This app never needs it.

# Optional: Google Calendar connection (server-only; never NEXT_PUBLIC_).
# Leave blank to hide the Calendar card.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts stored refresh tokens. Rotating it disconnects everyone's calendar.
CALENDAR_TOKEN_KEY=
