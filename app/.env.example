# Copy to .env.local for local work. In Vercel, set these under Settings → Environment Variables.
# Never commit real values, and never add the Supabase service-role key (the app doesn't use one).

# Public base address used in QR codes. Production: https://hiagain.link (read at build time).
# Local: http://localhost:3000. Leave unset to use whatever address the page was opened on.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API Keys). The publishable key is designed to be public;
# row-level security protects the data. Leave both blank for development-fixture mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Google Calendar connection (server only — never NEXT_PUBLIC_). Leave blank to hide it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts stored refresh tokens; changing it disconnects everyone's calendar.
CALENDAR_TOKEN_KEY=
