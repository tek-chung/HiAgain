{
  "name": "hi-again",
  "version": "0.1.0",
  "private": true,
  "description": "Hi Again first milestone: LinkedIn sign-in, QR sharing, guest saves and import.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:db": "bash scripts/test-db.sh",
    "verify": "npm run typecheck && npm test",
    "check:browser": "node scripts/browser-check.mjs",
    "check:signed-in": "bash scripts/e2e-signed-in.sh",
    "check:perf": "CHECKS=perf-check STUB_LATENCY_MS=80 bash scripts/e2e-signed-in.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "jsqr": "^1.4.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
